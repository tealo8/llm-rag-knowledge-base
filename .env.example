# Local demo only. Production must set APP_ENV=production and DEMO_MODE=false.
APP_ENV=development
DEMO_MODE=true
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=backend/data/knowledge.db
UPLOAD_DIR=backend/data/uploads
AUDIT_LOG_QUERIES=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
APP_PORT=8080

# Local Ollama generation and semantic embeddings use different purpose-built models.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=16
VECTOR_MIN_SIMILARITY=0.40
VECTOR_STORE=sqlite
CHROMA_PATH=backend/data/chroma
PGVECTOR_DSN=postgresql://knowledge:knowledge@127.0.0.1:5432/knowledge
PGVECTOR_DIMENSIONS=1024
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge
POSTGRES_DB=knowledge
OLLAMA_IMAGE=ollama/ollama:latest
MAX_UPLOAD_BYTES=20971520
MAX_CHUNKED_UPLOAD_BYTES=536870912
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50
TASK_QUEUE=inline
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
TASK_TIMEOUT_SECONDS=900

# Used only when a provider is set to openai.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Used only when EMBEDDING_PROVIDER=local (tests/offline degraded mode).
EMBEDDING_DIMENSIONS=384
